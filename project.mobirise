          "_name": "article16",
          "_sourceTheme": "startm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"article16\" group=\"Article\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"1\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"6\">\n        <input type=\"range\" name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" value=\"10\" step=\"1\">\n        <header>Background</header>\n        <input type=\"color\" title=\"Color\" name=\"bgColor\" value=\"#ffffff\">\n    </mbr-parameters>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-md-12 col-lg-{{textWidth}}\">\n                <div class=\"mbr-section-btn align-center\" mbr-buttons mbr-theme-style=\"display-4\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-secondary-outline\" href data-app-placeholder=\"Type Text\">Billetweb/Weezevent</a>  <a class=\"btn btn-secondary-outline\" href data-app-placeholder=\"Type Text\">Wordpress</a>  <a class=\"btn btn-secondary-outline\" href data-app-placeholder=\"Type Text\">PSD/InD/ILL<br></a> <a class=\"btn btn-secondary-outline\" href data-app-placeholder=\"Type Text\">Pack office<br></a> <a class=\"btn btn-secondary-outline\" href data-app-placeholder=\"Type Text\">Anglais B2<br></a> <a class=\"btn btn-secondary-outline\" href data-app-placeholder=\"Type Text\">Gestion de projet</a> <a class=\"btn btn-secondary-outline\" href data-app-placeholder=\"Type Text\">Coordination</a> <a class=\"btn btn-secondary-outline\" href data-app-placeholder=\"Type Text\">Animation d'ateliers artistiques et pédagogiques</a> <a class=\"btn btn-secondary-outline\" href data-app-placeholder=\"Type Text\">Création de supports</a> <a class=\"btn btn-secondary-outline\" href data-app-placeholder=\"Type Text\">Suivi administratif</a> <a class=\"btn btn-secondary-outline\" href data-app-placeholder=\"Type Text\">Relation partenaires</a> <a class=\"btn btn-secondary-outline\" href data-app-placeholder=\"Type Text\">Site web</a> <a class=\"btn btn-info-outline\" href data-app-placeholder=\"Type Text\">Polyvalence</a> <a class=\"btn btn-info-outline\" href data-app-placeholder=\"Type Text\">Ecoute</a> <a class=\"btn btn-info-outline\" href data-app-placeholder=\"Type Text\">Autonomie</a> <a class=\"btn btn-info-outline\" href data-app-placeholder=\"Type Text\">Sensibilité artistique</a></div>\n            </div>\n        </div>\n    </div>\n</section>",
